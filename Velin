#!/usr/bin/env python3

"""
Velin
A minimal environment configuration validator.

Features:
- Load variables from a .env file
- Validate required variables
- Detect empty values
- Detect duplicate keys
- Show configuration status without exposing secrets
- Generate a clean .env.example file

Usage:
    python velin.py check
    python velin.py check --file .env
    python velin.py example
"""

import argparse
import os
import re
from pathlib import Path


class Velin:
    def __init__(self, env_file=".env"):
        self.env_file = Path(env_file)
        self.variables = {}
        self.duplicates = []
        self.empty = []

    def load(self):
        if not self.env_file.exists():
            raise FileNotFoundError(
                f"Environment file not found: {self.env_file}"
            )

        for line_number, raw_line in enumerate(
            self.env_file.read_text(encoding="utf-8").splitlines(),
            start=1
        ):
            line = raw_line.strip()

            # Ignore empty lines and comments
            if not line or line.startswith("#"):
                continue

            # Remove optional "export"
            if line.startswith("export "):
                line = line[7:].strip()

            if "=" not in line:
                continue

            key, value = line.split("=", 1)
            key = key.strip()
            value = value.strip()

            if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", key):
                continue

            if key in self.variables:
                self.duplicates.append((key, line_number))

            self.variables[key] = value

            if not value:
                self.empty.append(key)

    def check_required(self):
        """
        Required variables can be defined through:
            VELIN_REQUIRED=API_KEY,DATABASE_URL,SECRET_KEY

        Or through a .velin file:
            API_KEY
            DATABASE_URL
            SECRET_KEY
        """

        required = []

        config_file = Path(".velin")

        if config_file.exists():
            for line in config_file.read_text(
                encoding="utf-8"
            ).splitlines():
                line = line.strip()

                if line and not line.startswith("#"):
                    required.append(line)

        env_required = os.getenv("VELIN_REQUIRED")

        if env_required:
            required.extend(
                item.strip()
                for item in env_required.split(",")
                if item.strip()
            )

        required = list(dict.fromkeys(required))

        missing = [
            key for key in required
            if key not in self.variables
            or not self.variables[key]
        ]

        return required, missing

    def mask(self, value):
        """Hide sensitive values from terminal output."""

        if not value:
            return "<empty>"

        if len(value) <= 4:
            return "****"

        return value[:2] + "*" * min(len(value) - 4, 12) + value[-2:]

    def check(self):
        try:
            self.load()
        except FileNotFoundError as error:
            print(f"[ERROR] {error}")
            return False

        required, missing = self.check_required()

        print("\nVelin Configuration Check")
        print("-" * 32)

        print(f"File: {self.env_file}")
        print(f"Variables: {len(self.variables)}")

        if not self.variables:
            print("[WARNING] No variables found.")

        if self.duplicates:
            print("\nDuplicate keys:")
            for key, line in self.duplicates:
                print(f"  - {key} (line {line})")

        if self.empty:
            print("\nEmpty values:")
            for key in self.empty:
                print(f"  - {key}")

        if required:
            print("\nRequired variables:")

            for key in required:
                if key in self.variables and self.variables[key]:
                    print(f"  [OK]      {key}")
                else:
                    print(f"  [MISSING] {key}")

        print("\nConfiguration:")
        for key, value in self.variables.items():
            print(f"  {key}={self.mask(value)}")

        problems = (
            bool(self.duplicates)
            or bool(self.empty)
            or bool(missing)
        )

        print("\n" + "-" * 32)

        if problems:
            print("Status: FAILED")
            return False

        print("Status: READY")
        return True

    def create_example(self):
        if not self.env_file.exists():
            print(f"[ERROR] File not found: {self.env_file}")
            return False

        try:
            self.load()
        except Exception as error:
            print(f"[ERROR] {error}")
            return False

        output = []

        for key in self.variables:
            output.append(f"{key}=")

        example_file = Path(".env.example")
        example_file.write_text(
            "\n".join(output) + "\n",
            encoding="utf-8"
        )

        print(f"[OK] Created {example_file}")
        return True


def main():
    parser = argparse.ArgumentParser(
        description="Velin - Minimal environment configuration validator"
    )

    parser.add_argument(
        "command",
        choices=["check", "example"],
        help="Command to execute"
    )

    parser.add_argument(
        "--file",
        default=".env",
        help="Path to the environment file"
    )

    args = parser.parse_args()

    velin = Velin(args.file)

    if args.command == "check":
        success = velin.check()
        raise SystemExit(0 if success else 1)

    if args.command == "example":
        success = velin.create_example()
        raise SystemExit(0 if success else 1)


if __name__ == "__main__":
    main()
